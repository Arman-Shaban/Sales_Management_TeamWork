    def reset_from(self):
        self.order_id.set(0)
        self.order_type.set("")
        self.customer_id.set(0)
        self.customer_name.set("")
        self.status.set("")
        self.payment_id(0)
        self.transaction_inventory_id(0)
        self.quantity.set(0)
        self.totalprice.set(0)
        self.datetime.set(0)
        self.ordertime.set(0)

        # Clear Table
        for item in self.table.get_children():
            self.table.delete(item)

        # Set All Products On Table
        for Product in self.controller.find_all()[1]:
            self.table.insert("", END, values=Product.to_tuple())

    #
    def save_click(self):
        success, message = self.controller.save(
            self.order_id.get(),
            self.order_type.get(),
            self.customer_id.get(),
            self.customer_name.get(),
            self.status.get(),
            self.payment_id.get(),
            self.transaction_inventory_id.get(),
            self.quantity.get(),
            self.totalprice.get(),
            self.datetime.get(),
            self.ordertime.get(),
        )

        if success:
            messagebox.showinfo("Success", message)
            self.reset_from()
        else:
            messagebox.showerror("Error", message)

