from tkinter import *
from tkinter import ttk ,messagebox

from controller.transaction_inventorycontroller import InventoryController


class InventoryView:
    def __init__(self):
        self.controller = InventoryController()

        self.win = Tk()
        self.win.geometry("600x350")
        self.win.title("Inventory")

        #InventoryID
        Label(self.win, text="Inventory Id").place(x=20,y=20)
        self.inventory_id = IntVar()
        Entry(self.win, textvariable=self.inventory_id).place(x=100, y = 20)

        # InventoryQuantity
        Label(self.win, text="InventoryQuantity").place(x=20,y=60)
        self.Inventoryquantity =  IntVar()
        Entry(self.win, textvariable=self.inventoryquantity).place(x=100, y = 600)

        # DeficitAmoung
        Label(self.win, text="DeficitAmoung").place(x=20,y=100)
        self.DeficitAmoung =  IntVar()
        Entry(self.win, textvariable=self.DeficitAmoung).place(x=100, y = 100)

        # DateTime
        Label(self.win, text ="DateTime").place(x=20,y=140)
        self.datetime = StrVar()
        Entry(self.win, textvariable=self.date_time).place(x=100,y=140)

        # table
        self.table = ttk.Treeview(self.win, show="headings", columns=[1,2,3,4])
        self.table.place(x=250, y =20)

        self.table.column(1, width=60)
        self.table.column(2, width=60)
        self.table.column(3, width=60)
        self.table.column(4, width=60)
      

        self.table.heading(1, text="Inventory Id")
        self.table.heading(2, text="Inventory Quantity")
        self.table.heading(3, text="DeficitAmoung")
        self.table.heading(4, text="Datetime")
        

        self.table.bind("<ButtonRelease>", self.table_click)

        Button(self.win, text="Save", command=self.save_click).place(x= 50, y = 200)
        self.reset_from()
        self.win.mainloop()


    def reset_from(self):
        self.inventory_id(0)
        self.inventory_Quantity(0)
        self.deficit_amoung.set(0)
        self.datetime.set(0)

        # Clear Table
        for item in self.table.get_children():
            self.table.delete(item)

        # Set All Inventory On Table
        for Order in self.controller.find_all()[1]:
            self.table.insert("", END, values=Inventory.to_tuple())

    def save_click(self):
        success, message = self.controller.save(
            self.inventory_id.get(),
            self.inventory_quantity.get(), 
            self.deficit_amoung.get(),
            self.datetime.get(),
         )

        if success:
            messagebox.showinfo("Success", message)
            self.reset_from()
        else:
            messagebox.showerror("Error", message)


