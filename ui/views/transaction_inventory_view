from tkinter import *
from tkinter import ttk ,messagebox

from controller.transaction_inventorycontroller import TransactionInventoryController


class TransactionInventoryView:
    def __init__(self):
        self.controller = TransactionInventoryController()

        self.win = Tk()
        self.win.geometry("600x350")
        self.win.title("TransactionInventory")

        #TransactionInventoryID
        Label(self.win, text="Transaction Inventory Id").place(x=20,y=20)
        self.Transaction_inventory_id = IntVar()
        Entry(self.win, textvariable=self.Transaction_inventory_id).place(x=100, y = 20)

        # TransactionInventoryType
        Label(self.win, text="Transaction Inventory Type").place(x=20, y=60)
        selfTransaction_inventory_type = StrVar()
        Entry(self.win, textvariable=self.Transaction_inventory_type).place(x=100, y=60)

        # ProductID
        Label(self.win, text="Product Id").place(x=20,y=100)
        self.product_id = IntVar()
        Entry(self.win, textvariable=self.product_id).place(x=100, y = 100)

        # OrderID
        Label(self.win, text="Order Id").place(x=20,y=140)
        self.Order_id =  IntVar()
        Entry(self.win, textvariable=self.Order_id).place(x=100, y = 140)

        # Quantity
        Label(self.win, text="Quantity").place(x=20,y=180)
        self.quantity =  IntVar()
        Entry(self.win, textvariable=self.quantity).place(x=100, y = 180)

        # DateTime
        Label(self.win, text ="DateTime").place(x=20,y=220)
        self.datetime = StrVar()
        Entry(self.win, textvariable=self.date_time).place(x=100,y=220)

        # table
        self.table = ttk.Treeview(self.win, show="headings", columns=[1,2,3,4,5,6])
        self.table.place(x=250, y =20)

        self.table.column(1, width=60)
        self.table.column(2, width=100)
        self.table.column(3, width=60)
        self.table.column(4, width=60)
        self.table.column(5, width=60)
        self.table.column(6, width=60)


        self.table.heading(1, text="TransactionInventory Id")
        self.table.heading(2, text="TransactionInventory Type")
        self.table.heading(3, text="Product Id")
        self.table.heading(4, text="Order Id")
        self.table.heading(5, text="Quantity")
        self.table.heading(6, text="Datetime")
        


        self.table.bind("<ButtonRelease>", self.table_click)

        Button(self.win, text="Save", command=self.save_click).place(x= 50, y = 200)
        self.reset_from()
        self.win.mainloop()


    def reset_from(self):
        self.transaction_inventory_id(0)
        self.transaction_inventory_type("")
        self.product_id.set(0)
        self.order_id.set(0)
        self.quantity.set(0)
        self.datetime.set(0)

        # Clear Table
        for item in self.table.get_children():
            self.table.delete(item)

        # Set All Transaction Inventory On Table
        for Order in self.controller.find_all()[1]:
            self.table.insert("", END, values=Order.to_tuple())

    def save_click(self):
        success, message = self.controller.save(
            self.transaction_inventory_id.get(),
            self.transaction_inventory_type.get(), 
            self.product_id.get(),
            self.order_id.get(),
            self.quantity.get(),
            self.datetime.get(),
         )

        if success:
            messagebox.showinfo("Success", message)
            self.reset_from()
        else:
            messagebox.showerror("Error", message)


